{
  "name": "neon-fall-protocol-zero",
  "version": "1.0.0",
  "private": true,
  "description": "NEON FALL: PROTOCOL ZERO — metroidvania cyberpunk 2D em Phaser + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host --port 8080",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
