{
  "name": "black-bird-revolucao",
  "version": "1.0.0",
  "private": true,
  "description": "Black Bird: Revolu\u00e7\u00e3o \u2014 metroidvania steampunk 2D em Phaser + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/build-info.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host --port 8080",
    "test": "vitest run",
    "test:browser": "node scripts/browser-regression.mjs",
    "test:combat:browser": "node scripts/browser-combat.mjs",
    "test:ux:browser": "node scripts/browser-ux.mjs",
    "assets:audit": "node scripts/audit-assets.mjs",
    "art:ground": "node scripts/prepare-ground.mjs",
    "art:production": "node scripts/prepare-production-art.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets": "node scripts/generate-assets.mjs",
    "art": "python3 scripts/process-painted-art.py && python3 scripts/slice-nero.py && python3 scripts/make-gameplay-art.py && node scripts/prepare-ground.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "jpeg-js": "0.4.4",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
